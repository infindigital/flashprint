# ---- Old WordPress demo pages: 410 Gone ----
RewriteRule ^sample-page/?$ - [G,L]
RewriteRule ^sample-2/?$ - [G,L]

# ---- WordPress system URLs that no longer exist ----
RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php|feed|comments/feed)(/.*)?$ - [G,L]
RewriteRule ^(page-sitemap|product-sitemap|product_cat-sitemap|local-sitemap|sitemap_index|wp-sitemap)\.xml$ /sitemap.xml [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain application/manifest+json
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType image/webp "access plus 7 days"
ExpiresByType image/jpeg "access plus 7 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
<FilesMatch "\.(woff2)$">
Header set Access-Control-Allow-Origin "*"
</FilesMatch>
</IfModule>

AddType application/manifest+json .webmanifest
AddType image/webp .webp
AddType font/woff2 .woff2
