# Flash Print Solution — Apache configuration (cPanel / shared hosting)
# Generated by src/build.js on 2026-09-11. Edit src/data/redirects.js, then rebuild.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS and the non-www domain. Leave commented if Cloudflare (or your host) already does this,
# otherwise it can cause a redirect loop with Cloudflare "Flexible" SSL.
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} ^www\. [NC]
# RewriteRule ^ https://flashprintsolution.com%{REQUEST_URI} [L,R=301,NE]

# ---- 301 redirects from the old WordPress site (174 rules) ----
